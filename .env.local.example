# Copy this file to .env.local (never commit .env.local).

# ---- Local development with the Firebase emulator (no real project needed) ----
NEXT_PUBLIC_USE_EMULATORS=1
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9199
FIREBASE_PROJECT_ID=demo-wbpcc

# ---- Real Firebase project (fill these when the party's project exists) ----
# From Firebase console → Project settings → Your apps → Web app config.
# These "public" values are safe in the browser; security comes from firestore.rules.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only secret: the service-account JSON on ONE line. Never share or commit it.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
